*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',Arial,sans-serif;color:#1d2433;background:#fff;line-height:1.6}
header{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;padding:14px 24px;background:#1f3a7a;color:#fff}
.logo{font-size:22px;font-weight:700}
nav a{color:#fff;text-decoration:none;margin-left:16px;font-size:15px}
nav a:hover{text-decoration:underline}
.hero{padding:80px 24px;text-align:center;color:#fff;background:linear-gradient(135deg,#1f3a7a,#3f6fd6)}
.hero h1{font-size:36px;margin:10px 0}
.hero p{max-width:640px;margin:0 auto 18px}
.tag{font-size:14px;letter-spacing:1px;opacity:.9}
.btn{display:inline-block;background:#fff;color:#1f3a7a;padding:12px 24px;border-radius:30px;text-decoration:none;font-weight:600}
.section{padding:50px 24px;max-width:1000px;margin:auto}
.light{max-width:none;background:#f4f6fb}
.light>*{max-width:900px;margin-left:auto;margin-right:auto}
h2{text-align:center;color:#1f3a7a;margin-bottom:22px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.card{background:#fff;padding:22px;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.1);text-align:center}
.card span{font-size:34px}
.card h3{margin:8px 0 6px;color:#1f3a7a}
button{background:#1f3a7a;color:#fff;border:0;padding:11px 20px;border-radius:8px;font-size:15px;cursor:pointer;margin:10px 8px 0 0}
button:hover{background:#3f6fd6}
button.alt{background:#e6ebf7;color:#1f3a7a}
label{display:block;font-weight:600;margin:12px 0 4px}
input,select,textarea{width:100%;padding:10px;border:1px solid #cbd3e4;border-radius:8px;font-size:15px}
.gen-box,.result{background:#fff;padding:20px;border-radius:12px;box-shadow:0 2px 10px rgba(0,0,0,.08);margin-bottom:16px}
pre{white-space:pre-wrap;font-family:Georgia,serif;background:#fafbfe;border:1px solid #e3e8f3;border-radius:8px;padding:16px}
.tips{margin-top:12px;color:#4a5570;font-size:14px}
.guide{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.info,.answer{margin-top:16px;background:#eef2fb;padding:16px;border-radius:10px;border-left:5px solid #1f3a7a}
.answer:empty{display:none}
.ask-box{display:flex;gap:10px}
.ask-box button{margin:0}
.contact{text-align:center}
footer{background:#1f3a7a;color:#fff;text-align:center;padding:16px;font-size:14px}
@media(max-width:600px){.hero h1{font-size:26px}.ask-box{flex-direction:column}nav a{margin:0 10px 0 0}}
@media print{header,.hero,#services,#generator .gen-box,#rights,.section.light:last-of-type,.contact,footer,button{display:none}}
